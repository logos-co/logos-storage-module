.DS_Store
build
.deps/
result
result/
cmake-build-*
build/
CMakeLists.txt.user
libs

# Doc-test output: generated artifacts are disposable, but keep the rendered
# .md that the docs embed. (report.html is published by CI to GitHub Pages,
# not committed.)
doctests/outputs/*
!doctests/outputs/*.md
# Disposable scratch dir for `./docs/preview.sh --doctest` (kept separate so it
# never clobbers the committed .md in doctests/outputs).
doctests/preview-outputs
doctest-local
